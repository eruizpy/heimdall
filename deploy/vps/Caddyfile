{$DOMAIN} {
	encode gzip

	# Device voice channel (WebSocket).
	handle /xiaozhi/v1/* {
		reverse_proxy xiaozhi-esp32-server:8000
	}

	# Vision analysis endpoint of the voice server.
	handle /mcp/vision/* {
		reverse_proxy xiaozhi-esp32-server:8003
	}

	# Console, manager-api and OTA (/xiaozhi/ota/).
	handle {
		reverse_proxy xiaozhi-esp32-server-web:8002
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
